%%{init: {"theme":"base","themeVariables":{"background":"#ffffff","mainBkg":"#ffffff","secondBkg":"#ffffff","clusterBkg":"#ffffff","edgeLabelBackground":"rgba(255,255,255,0)"},"themeCSS":".mermaid { background: #ffffff !important; } svg { background: #ffffff !important; background-color: #ffffff !important; } .background { fill: #ffffff !important; } .edgeLabel rect { fill: transparent !important; opacity: 0 !important; stroke: none !important; } .edgeLabel { background: transparent !important; } .edgeLabel p { background: transparent !important; } .labelBkg { fill: transparent !important; stroke: none !important; } .cluster rect { fill: transparent !important; fill-opacity: 1 !important; stroke: #d9d9d9 !important; stroke-width: 1px !important; } .cluster-label text { fill: #666666 !important; } .cluster-label span { color: #666666 !important; }","flowchart":{"htmlLabels":true,"wrappingWidth":220,"diagramPadding":96,"nodeSpacing":36,"rankSpacing":90}}}%%
flowchart TD
    classDef process fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;
    classDef event fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;
    classDef condition fill:#ffe0b2,stroke:#f57c00,stroke-width:2px;
    classDef state fill:#dcedc8,stroke:#689f38,stroke-width:2px;
    classDef command fill:#f8bbd0,stroke:#c2185b,stroke-width:2px;
    classDef error fill:#ffcdd2,stroke:#d32f2f,stroke-width:2px;
    classDef loop_node fill:#eeeeee,stroke:#616161,stroke-width:3px,stroke-dasharray: 5 5;
    classDef storage fill:#e1f5fe,stroke:#01579b,stroke-width:2px;
    classDef join fill:#ffffff,stroke:#616161,stroke-width:2px;

    subgraph PAPER[" "]
        direction TB

        %% ==========================================
        %% 0. SYSTEM INITIALIZATION
        %% ==========================================
        BOOT(("setup() Start Initialization")) --> WDT_INIT["Initialize Task Watchdog"]:::process
        WDT_INIT --> CTX_BEGIN["context.begin(): Initialize Actuators, NVS, and MQTT Service"]:::process
        CTX_BEGIN --> NVS_RESTORE[("Load latest_mode & is_night from NVS")]:::storage
        NVS_RESTORE --> COLLECTOR_INIT["collector.begin() and bindCollector()"]:::process
        COLLECTOR_INIT --> EVT_Q["Create eventQueue"]:::process
        EVT_Q --> TASKS_CREATE["Create SecTask (Priority 2) and MqttTask (Priority 1)"]:::process
        TASKS_CREATE --> SEC_START
        TASKS_CREATE --> MQTT_START

        %% Shared queues
        CMD_Q[("commandQueue<br/>(FIFO queue filled by MqttTask callback)")]:::storage
        EVT_RT_Q[("eventQueue<br/>(local events only)")]:::storage

        %% ==========================================
        %% 1. SECTASK MAIN LOOP
        %% ==========================================
        subgraph SEC_LOOP["SecTask Main Loop (20ms)"]
            direction TB
        SEC_START(("SecTask Entry")):::loop_node --> GET_TICKS["1. Now = millis()"]:::process

        %% 1A. Remote commands
        GET_TICKS --> MQ_READ{"1A. pollRemoteEvent()<br/>remote first, dequeue max 1 cmd/tick"}:::condition
        CMD_Q -.dequeue.-> MQ_READ
        REMOTE_DONE(( )):::join

        MQ_READ -->|"lock door / lock window / lock all"| MQ_LOCK_CHK{"Target still open?"}:::condition
        MQ_LOCK_CHK -->|"Yes"| MQ_LOCK_WARN["Set Warn + buzzer_warn<br/>Queue failed Ack + warn_lock_* status"]:::error --> REMOTE_DONE
        MQ_LOCK_CHK -->|"No"| MQ_LOCK_DO["Direct Action:<br/>Servo Lock + Queue Ack/Status"]:::command --> REMOTE_DONE
        MQ_READ -->|"unlock door / unlock window / unlock all"| MQ_UNLOCK_DO["Direct Action:<br/>Servo Unlock + Queue Ack/Status"]:::command --> REMOTE_DONE
        MQ_READ -->|"silence"| MQ_SIL["Direct Action:<br/>buzzer.stop() + Queue Ack/Status"]:::command --> REMOTE_DONE
        MQ_READ -->|"status"| MQ_STAT["Direct Action:<br/>Queue Status Publish + Ack"]:::command --> REMOTE_DONE
        MQ_READ -->|"keypad_help / help"| MQ_HELP_EVT["Return Event = keypad_help_request"]:::event --> MQ_RULE

        MQ_READ -->|"arm_night"| MQ_N_CHK{"latest_mode == disarm?"}:::condition
        MQ_N_CHK -->|"True"| MQ_N_EVT["Return Event = arm_night"]:::event --> MQ_RULE["engine.process(remote event, context)<br/>(direct path, not through eventQueue)"]:::process --> REMOTE_DONE
        MQ_N_CHK -->|"False"| MQ_N_REJ["Queue failed Ack only"]:::error --> REMOTE_DONE

        MQ_READ -->|"night_off"| MQ_N_OFF{"st.mode == Night?"}:::condition
        MQ_N_OFF -->|"True"| MQ_REV_EVT["Return Event = disarm or arm_away<br/>(based on latest_mode)"]:::event --> MQ_RULE
        MQ_N_OFF -->|"False"| MQ_N_OFF_REJ["Queue failed Ack only"]:::error --> REMOTE_DONE

        MQ_READ -->|"No Data / Ack-only"| REMOTE_DONE

        %% 1B. Keypad collection
        REMOTE_DONE --> KP_POLL{"2A. pollKeypad()"}:::condition
        KP_POLL -->|"Press 0-9"| KP_ADD["Append to PIN Buffer"]:::process --> TO_CHK
        KP_POLL -->|"Press *"| KP_BACK["Backspace (Remove 1 Char)"]:::process --> TO_CHK
        KP_POLL -->|"Press C"| KP_CLR["Clear Entire PIN Buffer"]:::process --> TO_CHK
        KP_POLL -->|"Press A"| KP_MUTE["Return Event = door_hold_warn_silence"]:::event
        KP_POLL -->|"Press B"| KP_SOS["Return Event = keypad_help_request"]:::event
        KP_POLL -->|"Press # -> valid"| KP_OK["Return Event = door_code_unlock"]:::event
        KP_POLL -->|"Press # -> invalid"| KP_FAIL["Return Event = door_code_bad"]:::event
        KP_POLL -->|"Idle"| BTN_POLL

        %% 1C. Manual buttons
        BTN_POLL{"2B. pollManualButtons_()"}:::condition
        BTN_POLL -->|"Door Lock/Unlock Button"| EV_BTN_D["Return Event = manual_door_toggle"]:::event
        BTN_POLL -->|"Window Lock/Unlock Button"| EV_BTN_W["Return Event = manual_window_toggle"]:::event
        BTN_POLL -->|"Idle"| RD_S_DOOR

        %% 1D. Sensor chain
        RD_S_DOOR{"2C. Read Reed Door"}:::condition
        RD_S_DOOR -->|"High"| EV_DOOR["Return Event = door_open"]:::event
        RD_S_DOOR -->|"Low || No Status Changed"| RD_S_WIN{"Read Reed Window"}:::condition

        RD_S_WIN -->|"High"| EV_WIN["Return Event = window_open"]:::event
        RD_S_WIN -->|"Low || No Status Changed"| RD_S_P1{"Read PIR 1"}:::condition

        RD_S_P1 -->|"High"| EV_P1["Return Event = motion 1"]:::event
        RD_S_P1 -->|"Low || No Status Changed"| RD_S_P2{"Read PIR 2"}:::condition

        RD_S_P2 -->|"High"| EV_P2["Return Event = motion 2"]:::event
        RD_S_P2 -->|"Low || No Status Changed"| RD_S_P3{"Read PIR Window"}:::condition

        RD_S_P3 -->|"High"| EV_P3["Return Event = motion 3"]:::event
        RD_S_P3 -->|"Low || No Status Changed"| RD_S_VIB{"Read Vibration"}:::condition

        RD_S_VIB -->|"High"| EV_VIB["Return Event = vib_spike"]:::event
        RD_S_VIB -->|"Low || No Status Changed"| US_SW{"Switch (usIndex)"}:::condition

        US_SW -->|"Case 0"| US1_CHK{"US1 Triggered? (<= 5cm)"}:::condition
        US1_CHK -->|"True"| EV_U1["Return Event = chk1"]:::event --> US_INC1["usIndex = 1"]:::process
        US1_CHK -->|"False || No Status Changed"| US_INC1 --> TO_CHK

        US_SW -->|"Case 1"| US2_CHK{"US2 Triggered? (<= 5cm)"}:::condition
        US2_CHK -->|"True"| EV_U2["Return Event = chk2"]:::event --> US_INC2["usIndex = 2"]:::process
        US2_CHK -->|"False || No Status Changed"| US_INC2 --> TO_CHK

        US_SW -->|"Case 2"| US3_CHK{"US3 Triggered? (<= 5cm)"}:::condition
        US3_CHK -->|"True"| EV_U3["Return Event = chk3"]:::event --> US_INC3["usIndex = 0"]:::process
        US3_CHK -->|"False || No Status Changed"| US_INC3 --> TO_CHK

        %% 1E. Local event enqueue
        KP_EVT_JOIN(( )):::join
        BTN_EVT_JOIN(( )):::join
        SENSOR_EVT_JOIN(( )):::join
        US_EVT_JOIN(( )):::join
        LOCAL_EVT_JOIN(( )):::join

        KP_MUTE --> KP_EVT_JOIN
        KP_SOS --> KP_EVT_JOIN
        KP_OK --> KP_EVT_JOIN
        KP_FAIL --> KP_EVT_JOIN

        EV_BTN_D --> BTN_EVT_JOIN
        EV_BTN_W --> BTN_EVT_JOIN

        EV_DOOR --> SENSOR_EVT_JOIN
        EV_WIN --> SENSOR_EVT_JOIN
        EV_P1 --> SENSOR_EVT_JOIN
        EV_P2 --> SENSOR_EVT_JOIN
        EV_P3 --> SENSOR_EVT_JOIN
        EV_VIB --> SENSOR_EVT_JOIN

        US_INC1 --> US_EVT_JOIN
        US_INC2 --> US_EVT_JOIN
        US_INC3 --> US_EVT_JOIN

        KP_EVT_JOIN --> LOCAL_EVT_JOIN
        BTN_EVT_JOIN --> LOCAL_EVT_JOIN
        SENSOR_EVT_JOIN --> LOCAL_EVT_JOIN
        US_EVT_JOIN --> LOCAL_EVT_JOIN

        LOCAL_EVT_JOIN --> EVT_ENQ["xQueueSend(eventQueue, event)"]:::process
        EVT_ENQ -.store.-> EVT_RT_Q
        EVT_ENQ --> TO_CHK

        %% 1F. Continue to drain
        TO_CHK["3. Continue to event drain"]:::process --> DRAIN_START

        %% 1G. Drain event queue
        DRAIN_START(( )):::join --> DRAIN_Q{"4. while (xQueueReceive(eventQueue))"}:::condition
        EVT_RT_Q -.dequeue while not empty.-> DRAIN_Q
        DRAIN_Q -->|"Event available"| RULE_PROCESS
        DRAIN_Q -->|"Queue empty"| ACT_UPD

        %% 1H. Rule engine
        RULE_PROCESS{"Process Event (RuleEngine)"}:::condition
        RULE_PROCESS --> RE_HELP{"Event == keypad_help_request?"}:::condition
        RE_HELP -->|"True"| RE_HELP_DO["Set Alert + buzzer_alert<br/>Queue MQTT: keypad_help"]:::command --> RULE_NEXT
        RE_HELP -->|"False"| RE_MANUAL{"Event == manual_door_toggle<br/>or manual_window_toggle?"}:::condition
        RE_MANUAL -->|"True"| RE_MANUAL_DO["Handle manual toggle:<br/>unlock directly<br/>lock only when closed, else warn"]:::command
        RE_MANUAL -->|"False"| RE_VIB{"Event == vib_spike?"}:::condition
        RE_VIB -->|"True"| RE_VIB_DO["Set Alert + buzzer_alert<br/>Queue MQTT: alert_high / alert_night_breach"]:::state --> RULE_NEXT
        RE_VIB -->|"False"| RE_LOCKED{"door_open while door_locked<br/>or window_open while window_locked?"}:::condition
        RE_LOCKED -->|"True"| RE_LOCKED_DO["Set Alert + buzzer_alert<br/>Queue MQTT: alert_door / alert_high / alert_night_breach"]:::state --> RULE_NEXT
        RE_LOCKED -->|"False"| RE_CUR_MODE{"Switch on st.mode"}:::condition

        DISARM_NEXT(( )):::join
        AWAY_NEXT(( )):::join
        NIGHT_NEXT(( )):::join
        RULE_NEXT(( )):::join
        RE_MANUAL_DO --> RULE_NEXT

        %% Disarm mode
        RE_CUR_MODE -->|"Disarm"| RE_D_AUTO{"Config.auto_arm == true"}:::condition
        RE_D_AUTO -->|"True"| S0{"st.exit_stage == 0<br/>&& Event == chk1"}:::condition
        RE_D_AUTO -->|"False / Other Event"| DISARM_NEXT
        S0 -->|"True"| SET_S1["st.exit_stage = 1;<br/>stage timeout = Now + 15000"]:::state --> DISARM_NEXT
        S0 -->|"False"| S1{"st.exit_stage == 1<br/>&& Event == door_open"}:::condition
        S1 -->|"True"| SET_S2["st.exit_stage = 2;<br/>stage timeout = Now + 15000"]:::state --> DISARM_NEXT
        S1 -->|"False"| S3_MOT{"st.exit_stage == 3<br/>&& Event == Indoor/Window?"}:::condition
        S3_MOT -->|"True"| CANCEL_ARM["st.exit_stage = 0 Cancel Auto-Arm"]:::error --> DISARM_NEXT
        S3_MOT -->|"False"| DISARM_NEXT

        %% Away mode
        RE_CUR_MODE -->|"Away"| RE_A_EV{"Analyze Event Category"}:::condition
        RE_A_EV -->|"motion 3"| RE_A_M3["Set Warn; Queue MQTT: warn_outside_motion"]:::state --> AWAY_NEXT
        RE_A_EV -->|"window_open / motion1 / motion2 / chk2 / chk3"| RE_A_STEP["Set Alert; Queue MQTT: alert_high"]:::state --> AWAY_NEXT
        RE_A_EV -->|"door_open"| RE_A_DOOR["Set Alert; Queue MQTT: alert_door"]:::state --> AWAY_NEXT

        %% Night mode
        RE_CUR_MODE -->|"Night"| RE_N_EV{"Analyze Event Category"}:::condition
        RE_N_EV -->|"Perimeter Breach (Door/Window/Vib/PIR3)"| RE_N_AL["Set Alert; Queue MQTT: alert_night_breach"]:::state --> NIGHT_NEXT
        RE_N_EV -->|"Indoor Motion"| RE_N_IGN["Ignore Activity (Sleep Mode Safe)"]:::process --> NIGHT_NEXT

        DISARM_NEXT --> RULE_NEXT
        AWAY_NEXT --> RULE_NEXT
        NIGHT_NEXT --> RULE_NEXT
        RULE_NEXT --> DRAIN_Q

        %% 1I. Periodic updates
        ACT_UPD["5. updateActuators(Now)"]:::command --> AUTO_TICK{"Auto-arm tick state change?"}:::condition
        AUTO_TICK -->|"stage1/2 timeout"| AUTO_RST["st.exit_stage = 0;<br/>flag = auto_arm_timeout_reset"]:::error --> DS_UPD
        AUTO_TICK -->|"stage2 && door closed"| AUTO_S3["st.exit_stage = 3;<br/>st.exit_timeout_ms = Now + 20000"]:::state --> DS_UPD
        AUTO_TICK -->|"stage3 timeout"| SET_AWAY[("st.mode = Away; Save NVS; st.exit_stage = 0")]:::storage --> DS_UPD
        AUTO_TICK -->|"No change"| DS_UPD

        DS_UPD{"doorSession_.check(Now)"}:::condition
        DS_UPD -->|"Event: Locked"| DS_CMD["servo1.lock();<br/>Queue MQTT auto_locked after servo reaches lock position"]:::command
        DS_UPD -->|"Other"| END_T
        DS_CMD --> END_T
            END_T(("vTaskDelay(20ms)")):::loop_node --> SEC_START
        end

        %% ==========================================
        %% 2. MQTT TASK (Background / Lower Priority)
        %% ==========================================
        subgraph MQTT_LOOP["MqttTask (10ms)"]
            direction TB
            MQTT_START(("MqttTask Entry")):::loop_node --> MQTT_NOW["Now = millis()"]:::process
            MQTT_NOW --> MQTT_TICK["context.mqttTick(Now)<br/>WiFi reconnect + MQTT reconnect + mqtt.loop<br/>Process Outgoing MQTT Queue + receive MQTT callback<br/>Debounced MQTT status LED update"]:::process
            MQTT_TICK -.enqueue incoming cmd.-> CMD_Q
            MQTT_TICK --> MQTT_DELAY(("vTaskDelay(10ms)")):::loop_node
            MQTT_DELAY --> MQTT_START
        end
    end
    style PAPER fill:#ffffff,stroke:#ffffff,stroke-width:0px



